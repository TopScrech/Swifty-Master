{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "fr",
      "hi",
      "it",
      "nl",
      "ru",
      "tr",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/mchakravarty/CodeEditorView",
      "version": {
        "up-to-next-major-version": "0.15.4",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/SafariCover",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/Appearance",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/swiftlang/swift-syntax",
      "version": {
        "version-range": "600.0.0..<1000.0.0",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "iOS",
      "target-membership": [
        "iOS",
        "macOS",
        "visionOS",
      ],
      "membership-exceptions": [
        {
          "target": "iOS",
          "exclusions": [
            "iOS.plist",
          ],
        }, {
          "target": "visionOS",
          "exclusions": [
            "AppIcon.icon",
            "Assets.xcassets",
            "Liquid Glass.icon",
            "Topics/Control/BrightnessScreenReaderUIView.swift",
            "Topics/Control/BrightnessScreenReaderView.swift",
            "Topics/Control/BrightnessSlider.swift",
            "iOS.plist",
          ],
        }, {
          "target": "macOS",
          "exclusions": [
            "Code Block/CodeBlockView.swift",
            "Liquid Glass.icon",
            "Topics/Control/BrightnessScreenReaderUIView.swift",
            "Topics/Control/BrightnessScreenReaderView.swift",
            "Topics/Control/BrightnessSlider.swift",
            "Topics/Control/TopicBadges.swift",
            "iOS.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Unit Tests", "target-membership": [ "Unit Tests" ] },
    {
      "kind": "folder",
      "path": "visionOS",
      "membership-exceptions": [
        {
          "target": "visionOS",
          "inclusions": [
            "Assets.xcassets",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "macOS",
      "membership-exceptions": [
        {
          "target": "macOS",
          "inclusions": [
            "CodeBlockView.swift",
          ],
        },
      ],
    },
    { "path": "LICENSE.txt" },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/iOS.app", "id": "F3BBD9DE2AEECD3400A9F7E7", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/visionOS.app", "id": "F3202C992D5596100030B3CC", "type": "wrapper.application", "index": false },
